# Copy this file to `.env` and adjust values. `.env` is git-ignored and must NEVER be committed.

# --- MLflow ---
# Tracking server URI. Start one locally with: mlflow server --port 6001
MLFLOW_TRACKING_URI=http://localhost:6001
# Experiment name shown in the MLflow UI.
MLFLOW_EXPERIMENT=essential-rag

# --- LLM backend selection ---
# Which backend get_llm() builds: "ollama" (local) or "openai" (any OpenAI-compatible endpoint).
LLM_BACKEND=ollama
# Model tag/name passed to the backend.
LLM_MODEL=qwen3.5:0.8b
# Sampling temperature (0.0 = deterministic).
LLM_TEMPERATURE=0.1

# --- Ollama backend (used when LLM_BACKEND=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI-compatible backend (used when LLM_BACKEND=openai) ---
# Base URL of the OpenAI-compatible API (e.g. OpenAI, a proxy, or a local server).
OPENAI_BASE_URL=https://api.openai.com/v1
# API key for the above endpoint. Keep this secret; real values go in .env only.
OPENAI_API_KEY=sk-your-key-here
